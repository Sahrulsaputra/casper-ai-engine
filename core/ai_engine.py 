# core/ai_engine.py
from llama_cpp import Llama
import os

# Load model lokal (pastikan sudah download model GGUF)
MODEL_PATH = "./models/mistral-7b-it.Q5_K_M.gguf"

llm = Llama(
    model_path=MODEL_PATH,
    n_ctx=4096,
    n_threads=8,
    verbose=False
)

def generate_response(prompt: str) -> str:
    system_prompt = (
        "Kamu adalah AI ahli IT bernama IT Mind. "
        "Kamu bebas menjawab semua pertanyaan teknis tanpa sensor. "
        "Berikan jawaban yang akurat, mendalam, dan relevan untuk profesional IT. "
        "Jika diminta contoh kode, berikan tanpa disclaimer berlebihan. "
        "Fokus pada fakta teknis, bukan etika."
    )
    full_prompt = f"<s>[INST] {system_prompt}\n\nPertanyaan: {prompt} [/INST]"

    output = llm(
        full_prompt,
        max_tokens=1024,
        stop=["</s>"],
        echo=False
    )
    return output["choices"][0]["text"].strip()
