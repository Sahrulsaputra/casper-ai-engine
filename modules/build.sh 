#!/bin/bash
# modules/build.sh

set -e

echo "🔧 Compiling C++ module with pybind11..."

c++ -O3 -Wall -shared -std=c++11 -fPIC \
    $(python3 -m pybind11 --includes) \
    binary_scanner.cpp \
    -o binary_scanner$(python3-config --extension-suffix)

echo "✅ Compilation successful: binary_scanner*.so"
